# Copy this file to secrets.toml and fill in your own values.
# secrets.toml is git-ignored. Never commit real values.

[snowflake]
account = "<org>-<account>"
user = "DASHBOARD_USER"
role = "ANALYST"
warehouse = "LOANPULSE_WH"
database = "LOANPULSE"
schema = "MARTS"
private_key_file = "<path-to>/.snowflake/dbt_user_key.p8"

[openrouter]
api_key = "<your-openrouter-api-key>"
models = [
    "openrouter/free",
    "nvidia/nemotron-3-ultra-550b-a55b:free",
    "google/gemma-4-26b-a4b-it:free",
]
